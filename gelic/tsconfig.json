{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [
      "chrome",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@agente/*": [
        "../agente-ia/src/*"
      ],
      "@nucleo/*": [
        "../sei-nucleo/src/*"
      ],
      "@comum/*": [
        "../sei-comum/src/*"
      ],
      "@favoritos/*": [
        "../favoritos/src/*"
      ],
      "@historico/*": [
        "../historico/src/*"
      ],
      "@projetos/*": [
        "../projetos/src/*"
      ],
      "@tarjar/*": [
        "../ferramentas-pdf/src/lib/*"
      ],
      "@/*": [
        "../ferramentas-pdf/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "empacotar.ts",
    "gerar.ts"
  ]
}
